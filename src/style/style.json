{
  "version": 8,
  "name": "chuanxi-outdoor",
  "projection": {
    "type": "globe"
  },
  "glyphs": "/fonts/{fontstack}/{range}.pbf",
  "sky": {
    "sky-color": "#0b1d33",
    "horizon-color": "#274a66",
    "fog-color": "#1E4E6B",
    "fog-ground-blend": 0.5,
    "atmosphere-blend": [
      "interpolate",
      [
        "linear"
      ],
      [
        "zoom"
      ],
      4,
      1,
      7,
      0
    ]
  },
  "sources": {
    "world": {
      "type": "vector",
      "url": "pmtiles:///data/world.pmtiles",
      "maxzoom": 6,
      "attribution": "Natural Earth (public domain)"
    },
    "dem": {
      "type": "raster-dem",
      "url": "pmtiles:///data/dem.pmtiles",
      "encoding": "terrarium",
      "tileSize": 256,
      "maxzoom": 12,
      "attribution": "Copernicus DEM GLO-30"
    },
    "relief": {
      "type": "raster",
      "url": "pmtiles:///data/relief.pmtiles",
      "tileSize": 256,
      "maxzoom": 13,
      "attribution": "ESA WorldCover 10m v2021 / Copernicus DEM GLO-30"
    },
    "osm": {
      "type": "vector",
      "url": "pmtiles:///data/osm.pmtiles",
      "attribution": "© OpenStreetMap contributors (ODbL)"
    },
    "hiking": {
      "type": "vector",
      "url": "pmtiles:///data/hiking.pmtiles",
      "attribution": "© OpenStreetMap contributors (ODbL)"
    },
    "contours": {
      "type": "vector",
      "url": "pmtiles:///data/contours.pmtiles",
      "maxzoom": 15,
      "attribution": "Copernicus DEM GLO-30"
    }
  },
  "terrain": {
    "source": "dem",
    "exaggeration": 1.3
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#1E4E6B"
      }
    },
    {
      "id": "world-ocean",
      "type": "fill",
      "source": "world",
      "source-layer": "ocean",
      "maxzoom": 8,
      "paint": {
        "fill-color": "#1E4E6B"
      }
    },
    {
      "id": "world-land",
      "type": "fill",
      "source": "world",
      "source-layer": "land",
      "maxzoom": 8,
      "paint": {
        "fill-color": "#C9C4A8"
      }
    },
    {
      "id": "world-lakes",
      "type": "fill",
      "source": "world",
      "source-layer": "lakes",
      "maxzoom": 8,
      "paint": {
        "fill-color": "#A9D3E8"
      }
    },
    {
      "id": "world-rivers",
      "type": "line",
      "source": "world",
      "source-layer": "rivers",
      "maxzoom": 8,
      "paint": {
        "line-color": "#7FB8D4",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          0.5,
          6,
          1.5
        ]
      }
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "dem",
      "minzoom": 5,
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "hillshade-method": "multidirectional",
        "hillshade-exaggeration": 0.45,
        "hillshade-shadow-color": "#3a4a3a",
        "hillshade-highlight-color": "#ffffff",
        "hillshade-accent-color": "#5a6b5a"
      }
    },
    {
      "id": "relief",
      "type": "raster",
      "source": "relief",
      "minzoom": 5,
      "paint": {
        "raster-opacity": 1,
        "raster-fade-duration": 0
      }
    },
    {
      "id": "water-glacier",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "minzoom": 7,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "glacier"
      ],
      "paint": {
        "fill-color": "#F2F6F8"
      }
    },
    {
      "id": "water-fill",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "minzoom": 7,
      "filter": [
        "!=",
        [
          "get",
          "class"
        ],
        "glacier"
      ],
      "paint": {
        "fill-color": "#A9D3E8"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "osm",
      "source-layer": "waterway",
      "minzoom": 9,
      "paint": {
        "line-color": "#7FB8D4",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "river",
              "canal"
            ],
            1.0,
            0.4
          ],
          14,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "river",
              "canal"
            ],
            4.0,
            1.5
          ]
        ]
      }
    },
    {
      "id": "contour",
      "type": "line",
      "source": "contours",
      "source-layer": "contours",
      "minzoom": 11,
      "paint": {
        "line-color": "#B49A7A",
        "line-width": [
          "case",
          [
            "to-boolean",
            [
              "get",
              "idx"
            ]
          ],
          1.4,
          0.8
        ],
        "line-opacity": [
          "case",
          [
            "to-boolean",
            [
              "get",
              "idx"
            ]
          ],
          0.6,
          0.35
        ]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "world",
      "source-layer": "countries",
      "maxzoom": 8,
      "paint": {
        "line-color": "#8A7A9A",
        "line-width": 1,
        "line-dasharray": [
          3,
          2
        ],
        "line-opacity": 0.7
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary",
          "unclassified",
          "residential",
          "minor",
          "service",
          "track"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk"
          ],
          "#C0552F",
          "primary",
          "#A87A28",
          "secondary",
          "#9C8A3E",
          [
            "unclassified",
            "residential",
            "minor",
            "service",
            "track"
          ],
          "#B0B0B0",
          "rgba(0,0,0,0)"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            3.2,
            "primary",
            2.5,
            "secondary",
            2.0,
            1.2
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            10,
            "primary",
            8,
            "secondary",
            6.5,
            "tertiary",
            5,
            3.5
          ]
        ]
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary",
          "unclassified",
          "residential",
          "minor",
          "service",
          "track"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk"
          ],
          "#E8734A",
          "primary",
          "#D9A441",
          "secondary",
          "#C9B45C",
          "tertiary",
          "#B9A98C",
          [
            "unclassified",
            "residential",
            "minor",
            "service",
            "track"
          ],
          "#FFFFFF",
          "#FFFFFF"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            1.2,
            "primary",
            1.0,
            "secondary",
            0.8,
            0.4
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            8,
            "primary",
            6.5,
            "secondary",
            5,
            "tertiary",
            3.5,
            2
          ]
        ]
      }
    },
    {
      "id": "trail-path",
      "type": "line",
      "source": "hiking",
      "source-layer": "hiking",
      "minzoom": 12,
      "filter": [
        "match",
        [
          "get",
          "highway"
        ],
        [
          "path",
          "footway",
          "steps"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#B4552E",
        "line-width": 2,
        "line-dasharray": [
          2,
          2
        ]
      }
    },
    {
      "id": "trail-track",
      "type": "line",
      "source": "hiking",
      "source-layer": "hiking",
      "minzoom": 13,
      "filter": [
        "==",
        [
          "get",
          "highway"
        ],
        "track"
      ],
      "paint": {
        "line-color": "#8B6B4A",
        "line-width": 1.6,
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "place-hamlet",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "minzoom": 13,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "hamlet"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "NotoSansSC-Regular"
        ],
        "text-size": 11,
        "text-variable-anchor": [
          "top",
          "bottom",
          "left",
          "right"
        ],
        "text-radial-offset": 0.8,
        "text-padding": 4,
        "text-allow-overlap": false,
        "text-ignore-placement": false,
        "symbol-sort-key": 3
      },
      "paint": {
        "text-color": "#3A3A3A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "place-village",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "minzoom": 11,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "village"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "NotoSansSC-Regular"
        ],
        "text-size": 12,
        "text-variable-anchor": [
          "top",
          "bottom",
          "left",
          "right"
        ],
        "text-radial-offset": 0.8,
        "text-padding": 4,
        "text-allow-overlap": false,
        "text-ignore-placement": false,
        "symbol-sort-key": 2
      },
      "paint": {
        "text-color": "#3A3A3A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "minzoom": 8,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "town"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "NotoSansSC-Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          12,
          14,
          16
        ],
        "text-variable-anchor": [
          "top",
          "bottom",
          "left",
          "right"
        ],
        "text-radial-offset": 0.8,
        "text-padding": 4,
        "text-allow-overlap": false,
        "text-ignore-placement": false,
        "symbol-sort-key": 1
      },
      "paint": {
        "text-color": "#3A3A3A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "minzoom": 5,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "city",
          "province",
          "state"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "NotoSansSC-Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          13,
          12,
          20
        ],
        "text-variable-anchor": [
          "top",
          "bottom",
          "left",
          "right"
        ],
        "text-radial-offset": 0.8,
        "text-padding": 4,
        "text-allow-overlap": false,
        "text-ignore-placement": false,
        "symbol-sort-key": 0
      },
      "paint": {
        "text-color": "#3A3A3A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "peak",
      "type": "symbol",
      "source": "osm",
      "source-layer": "mountain_peak",
      "minzoom": 10,
      "filter": [
        "has",
        "name:zh"
      ],
      "layout": {
        "text-field": [
          "concat",
          [
            "concat",
            "▲ ",
            [
              "coalesce",
              [
                "get",
                "name:zh"
              ],
              [
                "get",
                "name"
              ]
            ]
          ],
          "\n",
          [
            "get",
            "ele"
          ],
          " m"
        ],
        "text-font": [
          "NotoSansSC-Regular"
        ],
        "text-size": 11,
        "text-variable-anchor": [
          "top",
          "bottom",
          "left",
          "right"
        ],
        "text-radial-offset": 0.8,
        "text-padding": 4,
        "text-allow-overlap": false,
        "text-ignore-placement": false,
        "symbol-sort-key": 4
      },
      "paint": {
        "text-color": "#3A3A3A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "hut-poi",
      "type": "symbol",
      "source": "hiking",
      "source-layer": "hiking",
      "minzoom": 13,
      "filter": [
        "any",
        [
          "in",
          [
            "get",
            "tourism"
          ],
          [
            "literal",
            [
              "alpine_hut",
              "wilderness_hut",
              "camp_site"
            ]
          ]
        ],
        [
          "==",
          [
            "get",
            "natural"
          ],
          "saddle"
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "NotoSansSC-Regular"
        ],
        "text-size": 10,
        "text-variable-anchor": [
          "top",
          "bottom",
          "left",
          "right"
        ],
        "text-radial-offset": 0.8,
        "text-padding": 4,
        "text-allow-overlap": false,
        "text-ignore-placement": false,
        "symbol-sort-key": 5
      },
      "paint": {
        "text-color": "#5A3A2A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "trail-name",
      "type": "symbol",
      "source": "hiking",
      "source-layer": "hiking",
      "minzoom": 14,
      "filter": [
        "all",
        [
          "has",
          "name"
        ],
        [
          "has",
          "highway"
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "NotoSansSC-Regular"
        ],
        "text-size": 10,
        "symbol-placement": "line",
        "text-rotation-alignment": "map",
        "symbol-spacing": 350,
        "text-allow-overlap": false,
        "text-ignore-placement": false,
        "symbol-sort-key": 5
      },
      "paint": {
        "text-color": "#8A4A2E",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "road-ref",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "minzoom": 10,
      "filter": [
        "all",
        [
          "has",
          "ref"
        ],
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk",
            "primary",
            "secondary"
          ],
          true,
          false
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "ref"
        ],
        "text-font": [
          "NotoSansSC-Regular"
        ],
        "text-size": 10,
        "symbol-placement": "line",
        "text-rotation-alignment": "map",
        "symbol-spacing": 350,
        "text-allow-overlap": false,
        "text-ignore-placement": false
      },
      "paint": {
        "text-color": "#3A3A3A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.8
      }
    }
  ]
}